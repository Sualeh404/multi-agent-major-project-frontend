# LLM API Keys
GEMINI_API_KEY=your_gemini_api_key_here      # Primary LLM provider (2.5 Flash)
GROQ_API_KEY=your_groq_api_key_here        # Optional fallback
MISTRAL_API_KEY=your_mistral_api_key_here  # Optional fallback

# Scholarly APIs
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_key_here  # Optional, increases rate limit

# Redis
REDIS_URL=redis://localhost:6379

# Cost Tracking
USD_INR_RATE=83  # Fallback exchange rate

# Optional: Model Overrides
# HEAVY_LLM_MODEL=claude-3-5-sonnet-20240620
# LIGHT_LLM_MODEL=llama3-8b-8192
