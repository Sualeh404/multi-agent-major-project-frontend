# ---------------------------------------------------------------------------
# LLM Provider
# ---------------------------------------------------------------------------
# "cloud"  — Groq → Cerebras fallback chain for fast inference (default)
# "gemini" — Uses Google Gemini directly
# Users can also switch provider from the frontend Settings panel.
LLM_PROVIDER=cloud

# Cloud fallback chain (set whichever keys you have; tried in this order)
GROQ_API_KEY=your_groq_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Gemini (required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini-2.0-flash              # Optional model override

# Optional per-provider model overrides
# GROQ_MODEL=llama-3.3-70b-versatile
# CEREBRAS_MODEL=gpt-oss-120b

# ---------------------------------------------------------------------------
# Scholarly APIs
# ---------------------------------------------------------------------------
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_key_here  # Optional, increases rate limit

# ---------------------------------------------------------------------------
# App Security
# ---------------------------------------------------------------------------
APP_SECRET_KEY=your_secret_key_here  # API key auth; leave empty to disable
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173  # Comma-separated

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
SESSION_TTL_SECONDS=3600  # Session expiry (default 1 hour)

# Cost Tracking
USD_INR_RATE=83  # Fallback exchange rate
