# ---------------------------------------------------------------------------
# LLM Provider
# ---------------------------------------------------------------------------
# "cloud"  — Groq → Mistral → Cerebras fallback chain for fast inference (default)
# "gemini" — Uses Google Gemini directly
# Users can also switch provider from the frontend Settings panel.
LLM_PROVIDER=cloud

# Cloud fallback chain (set whichever keys you have; tried in this order)
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Gemini (required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini-2.0-flash              # Optional model override

# Optional per-provider model overrides
# GROQ_MODEL=llama-3.3-70b-versatile
# MISTRAL_MODEL=mistral-large-3
# CEREBRAS_MODEL=gpt-oss-120b

# ---------------------------------------------------------------------------
# Scholarly APIs
# ---------------------------------------------------------------------------
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_key_here  # Optional, increases rate limit

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# Cost Tracking
USD_INR_RATE=83  # Fallback exchange rate
